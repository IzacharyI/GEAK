--- a/aiter/ops/flydsl/kernels/flydsl_dispatch_combine_intranode_kernel.py
+++ b/aiter/ops/flydsl/kernels/flydsl_dispatch_combine_intranode_kernel.py
@@ -65,6 +65,361 @@ def _pack_f32x4_to_fp8(v4f32):
     )
 
 
+def make_combine_reduce_emitter(
+    *, model_dim, topk, npes, num_waves, max_tok, p2p_quant_type="none",
+    blockwise_fp8_transport=False, cur_rank_num_token=None, nominal_warp_num=None,
+    tok_ready_addr=None, tok_ready_epoch=None, tok_ready_arrival=None,
+    c_inp=None, c_out=None, c_tok_ready=None, c_peer_ready=None,
+    out_cache_modifier=None,
+):
+    """Host factory for the ONE shared combine reduce body.
+
+    Returns ``emit_combine_reduce`` — the per-token top-k reduction the fused
+    Stage1 combine third queue dispatches (and the standalone combine kernel's
+    Stage 3 reduces onto the same shape). The emitter blocks on the cross-rank
+    arrival counter (``c_tok_ready`` reaching ``topk * epoch``) before summing the
+    token's ``topk`` partials — already weight-scaled by the P2P scatter — into the
+    BF16 output row, so neither caller re-derives the arrival protocol or the
+    reduction. Configured once with the compile-time hidden geometry; the epoch and
+    the arrival target are passed per emit (dynamic) as ``tok_ready_epoch`` /
+    ``tok_ready_arrival``.
+    """
+    N_OUT = int(model_dim)
+    TOPK = int(topk)
+    blockwise_fp8_transport = bool(blockwise_fp8_transport)
+    # External hidden geometry (bf16 output rows). Blockwise FP8 transport packs the hidden
+    # dim as 1-byte FP8 elements plus a trailing per-32 microscale block, so the producer
+    # row stride is ``N_OUT + N_OUT // 32`` and the reduced output row doubles to bf16.
+    hidden_elem_size = 2
+    if blockwise_fp8_transport:
+        n_i32 = N_OUT // 4
+        nbytes = N_OUT + N_OUT // 32
+        out_n_i32 = (N_OUT * 2) // 4
+    else:
+        n_i32 = (N_OUT * hidden_elem_size) // 4
+        nbytes = N_OUT * hidden_elem_size
+        out_n_i32 = n_i32
+    # Cross-rank arrival protocol: a token is ready once all ``topk`` of THIS epoch's
+    # producers have bumped its readiness counter. The per-token expected arrival is topk.
+    tok_ready_expected = int(topk)
+
+    # Blockwise-FP8 vs bf16 decode/encode of one packed Int32 partial, defined once here so
+    # the single reducer body the two callers share never re-derives the transport dequant.
+    if blockwise_fp8_transport:
+
+        def _to_accum(i32_val):
+            _v2f32_fp8 = T.vec(2, T.f32)
+            lo = cvt_pk_f32_fp8(res=_v2f32_fp8, src=i32_val, word_sel=False)
+            hi = cvt_pk_f32_fp8(res=_v2f32_fp8, src=i32_val, word_sel=True)
+            return lo.shuffle(hi, [0, 1, 2, 3])
+
+        def _from_accum(accum_val):
+            return accum_val.to(fx.BFloat16).bitcast(fx.Int32)
+
+        def _zero_accum():
+            return Vec.filled(4, 0.0, fx.Float32)
+
+    else:
+
+        def _to_accum(i32_val):
+            return (
+                Vec.from_elements([i32_val], fx.Int32)
+                .bitcast(fx.BFloat16)
+                .to(fx.Float32)
+            )
+
+        def _from_accum(accum_val):
+            return accum_val.to(fx.BFloat16).bitcast(fx.Int32)[0]
+
+        def _zero_accum():
+            return Vec.filled(2, 0.0, fx.Float32)
+
+    def _accum_experts(vals):
+        acc = _to_accum(vals[0])
+        for k_slot in range(1, len(vals)):
+            acc = acc + _to_accum(vals[k_slot])
+        return _from_accum(acc)
+
+    # Masked buffer_load: returns 0 (i32) when vld_flag is false.
+    def _maybe_load(rsrc, offset, vld_flag, **kwargs):
+        raw = buffer_load(rsrc, offset, **kwargs)
+        return vld_flag.select(raw, 0)
+
+    # Shared Stage-3 partition of the reducer's OUTPUT work across the launch's warps. When
+    # the fused Stage1 role configures the emitter it passes the runtime local token count
+    # and the launch's nominal warp count so the reducer sizes its per-token warp fan-out
+    # identically to the standalone combine kernel's Stage 3.
+    safe_token_count = None
+    warps_per_tok = None
+    s3_total_work = None
+    if cur_rank_num_token is not None:
+        global_warp_num = int(nominal_warp_num)
+        # Clamp the denominator to 1 when cur_rank_num_token == 0 (the loop is empty then).
+        safe_token_count = (cur_rank_num_token == fx.Int32(0)).select(
+            fx.Int32(1), cur_rank_num_token
+        )
+        warps_per_tok = (
+            fx.Int32(global_warp_num) + safe_token_count - fx.Int32(1)
+        ) // safe_token_count
+        if blockwise_fp8_transport:
+            # Align warp partitions to the 8-Int32 blockwise FP8 microscale block.
+            _scale_blocks = fx.Int32(n_i32 // 8)
+            warps_per_tok = (warps_per_tok > _scale_blocks).select(
+                _scale_blocks, warps_per_tok
+            )
+        s3_total_work = cur_rank_num_token * warps_per_tok
+
+    # Compile-time reduce geometry the two callers share. Returned as ``consts`` so the
+    # fused Stage1 third queue reads the OUTPUT work domain ``s3_total_work`` (one reduced
+    # output row per local token) without re-deriving the partition.
+    consts = {
+        "N_OUT": N_OUT,
+        "TOPK": TOPK,
+        "n_i32": n_i32,
+        "out_n_i32": out_n_i32,
+        "nbytes": nbytes,
+        "warps_per_tok": warps_per_tok,
+        "safe_token_count": safe_token_count,
+        "s3_total_work": s3_total_work,
+        "blockwise_fp8_transport": blockwise_fp8_transport,
+        "tok_ready_expected": tok_ready_expected,
+    }
+
+    # Rank-local output buffer resource and cache selectors, built ONCE in the factory
+    # frame (the caller's device trace frame) BEFORE the directly decorated per-item
+    # body. Materializing rsrc_out and the wave-uniform readiness/output bases here —
+    # instead of inside a nested zero-argument @flyc.jit — keeps the system-scope
+    # readiness base and the output store base in live outer-frame scalar registers, so
+    # the fused GEMM1||GEMM2/P2P drain's register pressure cannot spill them into an
+    # uninitialized frame slot. The per-item @flyc.jit closes over these and performs
+    # only the dynamic token/partition arithmetic.
+    SLC_CACHE = _SLC_CACHE
+    # System-scope input cache selector: once a token's readiness is published across
+    # XCDs (tok_ready_addr wired by the fused caller), the reduce consumer's payload and
+    # microscale loads must be SYSTEM-scope (GLC|DLC atop SLC) so monotone cross-rank
+    # readiness holds — an ordinary SLC load can hit a stale L2 line from another XCD.
+    # The standalone caller (tok_ready_addr is None) keeps plain SLC.
+    IN_CACHE = _SLC_CACHE | 1 | 16 if tok_ready_addr is not None else _SLC_CACHE
+    u_c_out = _wave_uniform_i64(c_out)
+    rsrc_out = create_buffer_resource_from_addr(u_c_out)
+    u_c_tok_ready = _wave_uniform_i64(c_tok_ready)
+
+    @flyc.jit
+    def _emit_item(s3_work_idx):
+        """Reduce ONE warp-work item (a token's hidden slice) into ``c_out``.
+
+        ``s3_work_idx`` indexes the OUTPUT work domain: ``tok_id = s3_work_idx //
+        warps_per_tok`` selects the local token and ``part_id = s3_work_idx %
+        warps_per_tok`` its hidden partition. The item sums the token's ``topk`` already
+        weight-scaled partials — decoding blockwise FP8 microscales when the transport is
+        packed — into the bf16 output row. It carries NO workgroup barrier: readiness is a
+        per-token cross-rank spin on ``c_tok_ready`` (lane 0); the token-ready payload
+        loads are already system-scope (IN_CACHE = sc0|sc1) so no separate per-item
+        system-acquire fence is issued, and the reducer stays a warp-scoped work item the
+        fused third queue and the standalone Stage 3 dispatch identically."""
+        lane = fx.thread_idx.x % fx.Int32(64)
+        tok_id = s3_work_idx // warps_per_tok
+        part_id = s3_work_idx % warps_per_tok
+        token = tok_id
+        # Cross-rank arrival: each of the token's topk producers bumps c_tok_ready once
+        # per epoch; wait until all topk of THIS epoch land. No workgroup barrier — the
+        # reducer is a per-warp work item, lane 0 spins for the warp.
+        if lane == fx.Int32(0):
+            mori_shmem.int32_wait_until_greater_than(
+                u_c_tok_ready + fx.Int64(token) * fx.Int64(4), tok_ready_arrival
+            )
+
+        n_elems = n_i32
+        if const_expr(blockwise_fp8_transport):
+            # Align the per-warp hidden slice to the 8-Int32 microscale block.
+            scale_blocks = n_elems // 8
+            hdim_per_warp = (
+                (scale_blocks + warps_per_tok - 1) // warps_per_tok
+            ) * 8
+        else:
+            hdim_per_warp = (n_elems + warps_per_tok - 1) // warps_per_tok
+        hdim_off = part_id * hdim_per_warp
+
+        # This token's topk partials were plain-stored per (tok_id, k_slot) by the P2P
+        # scatter epilogue: row ``slot_idx`` at stride ``nbytes`` from ``c_inp``.
+        expert_rsrcs = []
+        expert_scale_rsrcs = []
+        expert_vlds = []
+        for k_slot in range_constexpr(TOPK):
+            slot_idx = tok_id * TOPK + k_slot
+            expert_tok_off = fx.Int64(slot_idx) * nbytes
+            expert_tok_addr = c_inp + expert_tok_off
+            # Warp-uniform base -> SGPR (avoids a per-lane address waterfall).
+            expert_tok_addr = _wave_uniform_i64(expert_tok_addr)
+            expert_rsrcs.append(create_buffer_resource_from_addr(expert_tok_addr))
+            if const_expr(blockwise_fp8_transport):
+                # Microscales trail the FP8 hidden bytes at + N_OUT within the row.
+                expert_scale_rsrcs.append(
+                    create_buffer_resource_from_addr(
+                        expert_tok_addr + fx.Int64(N_OUT)
+                    )
+                )
+            expert_vlds.append(fx.Boolean(1))
+
+        def _accum_step(
+            ec_abs,
+            U,
+            expert_rsrcs=expert_rsrcs,
+            expert_scale_rsrcs=expert_scale_rsrcs,
+            expert_vlds=expert_vlds,
+            tok_id=tok_id,
+        ):
+            vals = [[] for _ in range(U)]
+            scales = [[] for _ in range(U)]
+            scale_raws = [[] for _ in range(U)]
+            for k_slot in range_constexpr(TOPK):
+                rsrc_k = expert_rsrcs[k_slot]
+                vld_k = expert_vlds[k_slot]
+                for u in range_constexpr(U):
+                    # Select the optional per-u soffset by mutating a kwargs dict, then
+                    # issue the masked load and append in a SINGLE statement. Under the
+                    # FlyDSL AST rewriter an ``if`` lowers to dispatched then/else branch
+                    # functions, so a value bound to a fresh name inside those branches
+                    # does not survive to the enclosing scope; a dict mutation is a side
+                    # effect on an existing object, which does survive.
+                    kw = {}
+                    if u > 0:
+                        kw["soffset_bytes"] = u * 256
+                    vals[u].append(
+                        _maybe_load(
+                            rsrc_k, ec_abs, vld_k, vec_width=1, dtype=T.i32,
+                            cache_modifier=IN_CACHE, **kw,
+                        )
+                    )
+                    if const_expr(blockwise_fp8_transport):
+                        scale_idx = (ec_abs + u * 64) // 8
+                        sc_i32 = fx.Int32(0)
+                        if (lane & 7) == 0:
+                            sc_raw = _maybe_load(
+                                expert_scale_rsrcs[k_slot],
+                                scale_idx,
+                                vld_k,
+                                vec_width=1,
+                                dtype=T.i8,
+                                cache_modifier=IN_CACHE,
+                            )
+                            sc_i32 = (
+                                fx.Uint8(sc_raw).to(fx.Uint32).bitcast(fx.Int32)
+                            )
+                        scale_raws[u].append(sc_i32)
+
+            if const_expr(blockwise_fp8_transport):
+                # Broadcast after issuing all VMEM loads to avoid serial vmcnt waits.
+                for u in range_constexpr(U):
+                    for k_slot in range_constexpr(TOPK):
+                        sc_i32 = fx.Int32(
+                            ds_bpermute(
+                                T.i32,
+                                (lane & fx.Int32(~7)) * fx.Int32(4),
+                                scale_raws[u][k_slot],
+                            )
+                        )
+                        scales[u].append(
+                            (sc_i32 << fx.Int32(23)).bitcast(fx.Float32)
+                        )
+
+            if const_expr(blockwise_fp8_transport):
+                out_off = tok_id * out_n_i32 + ec_abs * 2
+                out_step = 512  # bf16 store on fp8-stride buffer: 2x
+            else:
+                out_off = tok_id * n_i32 + ec_abs
+                out_step = 256
+
+            for u in range_constexpr(U):
+                if const_expr(blockwise_fp8_transport):
+                    fp32_acc = _zero_accum()
+                    for k_slot in range_constexpr(TOPK):
+                        fp32_acc = (
+                            fp32_acc
+                            + _to_accum(vals[u][k_slot]) * scales[u][k_slot]
+                        )
+                    acc = _from_accum(fp32_acc)
+                else:
+                    acc = _accum_experts(vals[u])
+                kw = {"cache_modifier": SLC_CACHE}
+                if u > 0:
+                    kw["soffset_bytes"] = u * out_step
+                buffer_store(acc, rsrc_out, out_off, **kw)
+
+        def _accum_loop(end, U, hdim_off=hdim_off):
+            step = U * 64
+            # Align end down to step so the main loop never overruns; the tail
+            # covers the remainder (U == 1 => empty tail).
+            if const_expr(U > 1):
+                main_end = (end // step) * step
+            else:
+                main_end = end
+            for ec in range(lane, main_end, step):
+                _accum_step(hdim_off + ec, U)
+            if const_expr(U > 1):
+                for ec in range(main_end + lane, end, 64):
+                    _accum_step(hdim_off + ec, 1)
+
+        rem_hdim = n_elems - hdim_off
+        eff_end = (rem_hdim < hdim_per_warp).select(rem_hdim, hdim_per_warp)
+        if _S3_WIDE_PATH_THRESHOLD_I32 < hdim_per_warp:
+            # Wide path: U4 only when BOTH the row and the per-warp hidden slice are
+            # 256-aligned; U2 for the wide-but-misaligned slice. Row divisibility alone
+            # never selects U4 (that would over-pressure a misaligned per-warp slice).
+            if const_expr(n_i32 % 256 == 0):
+                if (hdim_per_warp % 256) < 1:
+                    _accum_loop(eff_end, 4)
+                else:
+                    _accum_loop(eff_end, 2)
+            else:
+                _accum_loop(eff_end, 1)
+        else:
+            _accum_loop(eff_end, 1)
+
+    return (consts, _emit_item)
+
+
+def emit_combine_barrier_and_reduce(
+    *, model_dim, topk, npes, num_waves, max_tok, global_warp_id, global_warp_num,
+    cur_rank_num_token, nominal_warp_num, c_inp, c_out, c_tok_ready, c_peer_ready,
+    tok_ready_epoch, tok_ready_arrival, p2p_quant_type="none",
+    blockwise_fp8_transport=False, out_cache_modifier=None,
+):
+    """Shared combine barrier+reduce entry both the fused and standalone paths route
+    through: configure the ONE reducer via ``make_combine_reduce_emitter`` and drain the
+    OUTPUT work domain, one workgroup barrier before the loop so every warp sees the same
+    published partials, then per-warp ``_emit_item`` items (each of which spins on the
+    cross-rank arrival counter, never re-taking a workgroup barrier)."""
+    (consts, _emit_item) = make_combine_reduce_emitter(
+        model_dim=model_dim,
+        topk=topk,
+        npes=npes,
+        num_waves=num_waves,
+        max_tok=max_tok,
+        p2p_quant_type=p2p_quant_type,
+        blockwise_fp8_transport=blockwise_fp8_transport,
+        cur_rank_num_token=cur_rank_num_token,
+        nominal_warp_num=nominal_warp_num,
+        c_inp=c_inp,
+        c_out=c_out,
+        c_tok_ready=c_tok_ready,
+        c_peer_ready=c_peer_ready,
+        tok_ready_epoch=tok_ready_epoch,
+        tok_ready_arrival=tok_ready_arrival,
+        out_cache_modifier=out_cache_modifier,
+    )
+    fx.barrier()
+    # The OUTPUT-domain grid-stride walk over ``s3_total_work`` is DRIVEN INLINE by the
+    # caller's ``@flyc.kernel`` body, not here. ``s3_total_work`` and ``global_warp_id`` are
+    # dynamic device values; a Python ``range()`` over them only lowers to a device loop
+    # under the kernel decorator's AST rewrite, which does not reach a plain helper (a
+    # helper's ``range()`` runs as real Python and rejects the dynamic bound). This helper
+    # only configures the shared reducer (barrier + per-item emitter) and returns them so
+    # the caller strides ``for s3_work_idx in range(global_warp_id, s3_total_work,
+    # global_warp_num): _emit_item(s3_work_idx)`` inline.
+    return (consts, _emit_item)
+
+
 def make_dispatch_kernel(
     *,
     rank: int,
@@ -945,7 +1300,38 @@ def make_combine_kernel(
             hdim_per_warp = (n_elems + warps_per_tok - 1) // warps_per_tok
         s3_total_work = cur_rank_num_token * warps_per_tok
 
-        for s3_work_idx in range(global_warp_id, s3_total_work, global_warp_num):
+        # The fused-upstream transport (skip_stage1: the k partials are plain-stored per
+        # (tok_id, k_slot) at addr_shmem_tok + slot_idx*nbytes) shares the ONE reduce body
+        # with the fused Stage1 combine third queue through emit_combine_barrier_and_reduce
+        # -> make_combine_reduce_emitter, so neither caller re-derives the top-k reduction.
+        # The legacy decode/zero-copy transport keeps its in-kernel decode reduce below.
+        # Exactly one of the two runs (compile-time split on the transport layout); the
+        # inline loop bound collapses to zero when the shared helper owns the reduce.
+        if const_expr(skip_stage1 and not zero_copy):
+            (_sc_consts, _sc_emit) = emit_combine_barrier_and_reduce(
+                model_dim=hidden_dim, topk=experts_per_token, npes=npes,
+                num_waves=warp_num_per_block, max_tok=max_tok_per_rank,
+                global_warp_id=global_warp_id, global_warp_num=global_warp_num,
+                cur_rank_num_token=cur_rank_num_token,
+                nominal_warp_num=global_warp_num,
+                c_inp=addr_shmem_tok, c_out=addr_out_shmem_tok,
+                c_tok_ready=addr_inp_shmem_tok_id_to_src, c_peer_ready=addr_p2p_tok,
+                tok_ready_epoch=fx.Int32(0), tok_ready_arrival=fx.Int32(-1),
+                blockwise_fp8_transport=blockwise_fp8_transport,
+            )
+            # Drive the shared reducer's OUTPUT work domain INLINE in this @flyc.kernel body
+            # so the dynamic grid-stride range is AST-rewritten into a device loop; the same
+            # single reducer (make_combine_reduce_emitter) the fused Stage1 third queue uses.
+            _sc_total = _sc_consts["s3_total_work"]
+            for s3_work_idx in range(global_warp_id, _sc_total, global_warp_num):
+                _sc_emit(s3_work_idx)
+        _s3_inline = not (skip_stage1 and not zero_copy)
+
+        for s3_work_idx in range(
+            global_warp_id,
+            (s3_total_work if _s3_inline else fx.Int32(0)),
+            global_warp_num,
+        ):
             tok_id = s3_work_idx // warps_per_tok
             part_id = s3_work_idx % warps_per_tok
             hdim_off = part_id * hdim_per_warp
